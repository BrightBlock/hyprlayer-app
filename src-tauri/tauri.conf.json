{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hyprlayer",
  "mainBinaryName": "Hyprlayer",
  "version": "0.1.7",
  "identifier": "ai.brightblock.hyprlayer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Workspace",
        "width": 1280,
        "height": 800,
        "minWidth": 1180,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://brightblock.ai/hyprlayer/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NzU2MkZENTE2QTQzQzEKUldUQlEycFIvV0oxOUVhR0pUVG9KamlFNENvcVpURi8yY2RZNWVLV2JZNmFneUp0VnlDZk84ZFgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

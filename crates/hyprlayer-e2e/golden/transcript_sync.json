                "working": true
              },
              {
                "device": "device-a",
                "rev": 4,
                "turns": [
                  "assistant"
                ],
                "working": true
              }
            ]
          },
          "guard": "B hears each commit with its author",
          "ok": true
        },
        {
          "evidence": {
            "rev": 4,
            "seen": true,
            "working": false
          },
          "guard": "the turn's end is announced",
          "ok": true
        },
        {
          "evidence": {
            "withinOneSecond": true
          },
          "guard": "B receives A's committed reply within 1s of A",
          "ok": true
        }
      ],
      "step": "B follows A's next turn"
    },
    {
      "guards": [
        {
          "evidence": {
            "author": {
              "clientId": "client-a",
              "device": "device-a"
            }
          },
          "guard": "the last user message is stored with A as its author",
          "ok": true
        }
      ],
      "step": "the stored message keeps its author"
    },
    {
      "guards": [
        {
          "evidence": {
            "first": null,
            "second": null
          },

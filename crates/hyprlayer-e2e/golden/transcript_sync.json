          },
          "guard": "A's user message carries A and rev 1",
          "ok": true
        },
        {
          "evidence": {
            "device": "device-a",
            "rev": 2
          },
          "guard": "the reply commits rev 2 under A",
          "ok": true
        },
        {
          "evidence": {
            "hasSeq": false,

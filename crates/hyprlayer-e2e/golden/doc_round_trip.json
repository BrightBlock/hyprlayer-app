      "step": "property edits write YAML and keep unknown keys"
    },
    {
      "guards": [
        {
          "evidence": {
            "code": "frontmatter_patch"
          },
          "guard": "a Patch on malformed.md is refused with frontmatter_patch, file unchanged",
          "ok": true
        },
        {
          "evidence": {
            "accepted": true,
            "frontmatter_unchanged": true
          },
          "guard": "a body-only save on malformed.md is accepted and its frontmatter bytes are untouched",
          "ok": true
        },
        {
          "evidence": {
            "code": "frontmatter_patch"
          },
          "guard": "an invalid Raw is refused",
          "ok": true
        },
        {
          "evidence": {
            "body_unchanged": true,
            "fm_error_gone": true
          },
          "guard": "a valid Raw clears fm_error and leaves the body untouched",
          "ok": true
        },
        {
          "evidence": {
            "only_targeted_lines_changed": true
          },
          "guard": "a Raw save on a well-formed doc changes only the targeted lines",
          "ok": true
        }
      ],
      "step": "a malformed block is only replaced explicitly"

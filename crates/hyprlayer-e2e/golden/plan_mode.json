{
  "scenario": "plan_mode",
  "steps": [
    {
      "guards": [
        {
          "evidence": {
            "spawns": [
              "spawn plan"
            ]
          },
          "guard": "the harness is launched in plan mode",
          "ok": true
        },
        {
          "evidence": {
            "mode_events": 0
          },
          "guard": "a turn with no mode change reports none",
          "ok": true
        }
      ],
      "step": "launch a session in plan mode"
    },
    {
      "guards": [
        {
          "evidence": {
            "asked": true
          },
          "guard": "ExitPlanMode asks the user first",
          "ok": true
        },
        {
          "evidence": {
            "modes": [
              "default"
            ]
          },
          "guard": "the client hears the harness leave plan mode",
          "ok": true
        },
        {
          "evidence": {
            "mode": "default"
          },
          "guard": "the row records the mode the harness left plan mode for",
          "ok": true
        }
      ],
      "step": "the agent exits plan mode"
    },
    {
      "guards": [
        {
          "evidence": {
            "kinds": [
              "userMessage",
              "init",
              "assistantText",
              "turnDone",
              "userMessage",
              "permissionAsk",
              "assistantText",
              "turnDone"
            ]
          },
          "guard": "the stored log carries no mode change",
          "ok": true
        }
      ],
      "step": "the mode change is live state, not history"
    },
    {
      "guards": [
        {
          "evidence": {
            "resumed": true
          },
          "guard": "the resume is accepted",
          "ok": true
        },
        {
          "evidence": {
            "spawns": [
              "spawn plan"
            ]
          },
          "guard": "it attaches to the running harness instead of relaunching",
          "ok": true
        }
      ],
      "step": "resume in the mode the harness chose"
    },
    {
      "guards": [
        {
          "evidence": {
            "resumed": true
          },
          "guard": "the resume is accepted",
          "ok": true
        },
        {
          "evidence": {
            "running": "default"
          },
          "guard": "the resume reports the harness's own mode",
          "ok": true
        },
        {
          "evidence": {
            "spawns": [
              "spawn plan"
            ]
          },
          "guard": "no relaunch",
          "ok": true
        }
      ],
      "step": "a different mode attaches to the running harness"
    },
    {
      "guards": [
        {
          "evidence": {
            "restarted": true
          },
          "guard": "the restart is accepted",
          "ok": true
        },
        {
          "evidence": {
            "spawns": [
              "spawn plan",
              "spawn acceptEdits"
            ]
          },
          "guard": "the harness is relaunched in the requested mode",
          "ok": true
        }
      ],
      "step": "restart applies a different mode"
    },
    {
      "guards": [
        {
          "evidence": {
            "heard": [
              "acceptEdits"
            ],
            "mode": "acceptEdits"
          },
          "guard": "a switch to Accept edits is heard and recorded",
          "ok": true
        },
        {
          "evidence": {
            "heard": [],
            "mode": null
          },
          "guard": "the harness's report of Auto's own mode leaves the row on Auto and reaches no client",
          "ok": true
        }
      ],
      "step": "an in-place switch to Auto stays Auto"
    },
    {
      "guards": [
        {
          "evidence": {
            "exit": 0,
            "listening": false
          },
          "guard": "shutdown stops the server cleanly",
          "ok": true
        }
      ],
      "step": "shutdown"
    }
  ]
}
